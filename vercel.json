
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "python": {
      "root": "sdk/python",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "python"
      }
    }
  ]
}
